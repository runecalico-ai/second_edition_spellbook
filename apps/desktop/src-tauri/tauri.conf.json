{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spellbook",
  "mainBinaryName": "spellbook-desktop",
  "version": "0.1.0",
  "identifier": "com.local.spellbook",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "bundle": {
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["resources/sqlite-vec/*"],
    "windows": {
      "nsis": {
        "installerHooks": "installer/vcredist-check.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Spellbook",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  }
}
